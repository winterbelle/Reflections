JWT_SECRET=your_secret_here

# Each developer will need their own OpenAI API key.
# Create one here:
# https://platform.openai.com/api-keys

OPENAI_API_KEY=your_openai_api_key_here

# Setup steps:
# 1. Sign into the OpenAI platform
# 2. Click "Create new secret key"
# 3. Copy the key immediately
# 4. Add it to your local server/.env file
#
# Example:
# OPENAI_API_KEY=sk-xxxxxxxx
#
# IMPORTANT:
# - Never push real API keys to GitHub
# - Never share API keys in Slack/messages
# - .env is ignored by Git through .gitignore


CHATBOT_ENABLED=false

DATABASE_URL=postgresql://username:password@localhost:5432/database_name